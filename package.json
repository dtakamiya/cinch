{
  "name": "cinch",
  "version": "1.0.0",
  "description": "ローカルの Claude Code セッションログを解析し、セッション単位で使い方を採点するローカル Web アプリ",
  "scripts": {
    "test": "vitest run",
    "threshold-report": "tsx server/scripts/threshold-report.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "concurrently --kill-others-on-fail -n api,web \"tsx server/index.ts\" \"vite\"",
    "start:e2e": "concurrently --kill-others-on-fail -n api,web \"tsx server/index.ts\" \"vite --host 127.0.0.1 --port $E2E_WEB_PORT --strictPort\"",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "claude-code",
    "session-analysis",
    "scoring"
  ],
  "author": "d.miyataka@gmail.com",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
